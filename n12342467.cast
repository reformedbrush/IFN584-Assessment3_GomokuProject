[519.5189554691315,"o","\n========================== GomokuPlus Help ==========================\r"]
[519.5190315246582,"o","\nMove syntax: [Type][Row]:[Col]   (rows and columns run 1 to 10)\r"]
[519.5190842151642,"o","\n  O[Row]:[Col]  Place an Ordinary Stone            e.g. O3:4\r"]
[519.5191388130188,"o","\n  H[Row]:[Col]  Place a Heavy Stone  (2 per game)  e.g. H5:5\r"]
[519.5192136764526,"o","\n  E[Row]:[Col]  Eraser targeting an opponent's     e.g. E3:3\r"]
[519.5192749500275,"o","\n                Ordinary Stone      (2 per game)\r"]
[519.5193514823914,"o","\n"]
[519.5194365978241,"o","\nOther commands during your turn:\r"]
[519.5195121765137,"o","\n  S   Save the current game to a file\r"]
[519.5195565223694,"o","\n  ?   Show this help menu\r"]
[519.5196425914764,"o","\n  Q   Quit the current game and return to the main menu\r"]
[519.5197150707245,"o","\n"]
[519.5197911262512,"o","\nRules:\r"]
[519.5198497772217,"o","\n  - Align 5 of your stones (Ordinary or Heavy) in a row - horizontal,\r"]
[519.5199131965637,"o","\n    vertical, or diagonal - to win instantly.\r"]
[519.5199780464172,"o","\n  - Heavy Stones cannot be targeted or removed by an Eraser Stone.\r"]
[519.5200719833374,"o","\n  - Each player starts with 2 Heavy Stones and 2 Eraser Stones.\r"]
[519.5201635360718,"o","\n  - Ordinary Stones are unlimited.\r"]
